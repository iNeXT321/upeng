[{"tableName": "public.orders", "tableComment": "订单主表：一笔交易一行，记录订单金额、状态、渠道与归属区域", "domain": "交易", "synonyms": ["订单", "交易", "成交", "销售订单"], "rowCount": 12500000, "primaryKeys": ["order_id"], "columns": [{"columnName": "order_id", "dataType": "bigint", "comment": "订单ID，主键", "synonyms": ["订单号"]}, {"columnName": "order_date", "dataType": "date", "comment": "下单日期，分区字段", "synonyms": ["日期", "时间", "下单时间"], "timePartition": true}, {"columnName": "user_id", "dataType": "bigint", "comment": "下单用户ID，关联dim_users.user_id", "synonyms": ["用户", "客户"]}, {"columnName": "channel", "dataType": "varchar(32)", "comment": "销售渠道", "synonyms": ["渠道"], "enumValues": ["app=手机APP", "web=官网", "mini=微信小程序", "offline=线下门店", "third=第三方平台"]}, {"columnName": "region", "dataType": "varchar(32)", "comment": "销售大区", "synonyms": ["区域", "大区", "地区"], "enumValues": ["east=华东", "south=华南", "north=华北", "central=华中", "west=西部", "northeast=东北"]}, {"columnName": "gmv", "dataType": "numeric(18,2)", "comment": "订单金额(GMV)，单位元", "synonyms": ["销售额", "营收", "金额", "成交额", "GMV"]}, {"columnName": "order_status", "dataType": "int", "comment": "订单状态", "synonyms": ["状态"], "enumValues": ["0=待支付", "1=已支付", "2=已发货", "3=已完成", "4=已取消", "5=已退款"]}, {"columnName": "discount_amount", "dataType": "numeric(18,2)", "comment": "优惠金额，单位元", "synonyms": ["优惠", "折扣金额"]}, {"columnName": "pay_time", "dataType": "timestamp", "comment": "支付时间，未支付为NULL"}, {"columnName": "buyer_phone", "dataType": "varchar(32)", "comment": "买家手机号", "sensitive": true}]}, {"tableName": "public.order_items", "tableComment": "订单明细表：一个订单下每个商品一行", "domain": "交易", "synonyms": ["订单明细", "商品明细", "购买明细"], "rowCount": 45000000, "primaryKeys": ["item_id"], "columns": [{"columnName": "item_id", "dataType": "bigint", "comment": "明细ID，主键"}, {"columnName": "order_id", "dataType": "bigint", "comment": "订单ID，关联orders.order_id", "synonyms": ["订单号"]}, {"columnName": "sku_id", "dataType": "bigint", "comment": "商品SKU ID，关联dim_products.sku_id", "synonyms": ["商品", "SKU"]}, {"columnName": "q